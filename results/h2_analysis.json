{
  "hypotheses": {
    "H1": "a quantum kernel is competitive with, or beats, tuned classical models",
    "H2": "g(K_C || K_Q) predicts the AUC gap",
    "H3": "kernel concentration (off-diagonal variance shrinking with n) degrades the QSVM",
    "H4": "at fixed n, smaller bandwidth c avoids concentration and restores AUC"
  },
  "significance_rule": "mean difference over seeds within one seed-to-seed sd (paired, ddof=1) -> 'not significant'; correlations: 95% bootstrap CI over configurations containing 0",
  "verdicts": {
    "H1": {
      "held": "no: no reliable advantage; competitive only at small n",
      "detail": "2 of 34 (model, map, n) combinations beat the RBF-SVM by more than the seed spread (fidelity QSVM ZZ map, reps 1 n=2: +0.0066 \u00b1 0.0044, fidelity QSVM ZZ map, reps 2 n=2: +0.0077 \u00b1 0.0038); ~1.5 such positive hits are expected by chance under a true gap of 0 with this lenient 1-sd rule; 0 beat the best of the three classical models. 17 of 34 are not significantly worse than the RBF-SVM (fidelity QSVM: 10 of 17), mostly the Z map and n <= 4; ZZ maps fall significantly behind from n = 6 on"
    },
    "H2": {
      "held": "no: g does not predict the gap in the hypothesised direction",
      "detail": "(pooled, lambda=0.01) rho(g, gap) = -0.44 [-0.61, -0.22]; (b) partial | log var = -0.66 [-0.75, -0.54]; (a) within map: Z map, reps 2 -0.77 [-0.90, -0.56], ZZ map, reps 1 -0.27 [-0.66, 0.21], ZZ map, reps 2 -0.06 [-0.45, 0.40]; lambda=0.1 pooled 0.34 [0.09, 0.54] but partial | log var 0.03 [-0.19, 0.25], i.e. explained by kernel variance; (c) label-aware log(s_C/s_Q): pooled -0.63 [-0.75, -0.48], partial -0.61 [-0.73, -0.44] -- also negative, and computed where Huang's bound is vacuous (see label_aware.bound_regime)"
    },
    "H3": {
      "held": "yes for concentration towards 1/2^n; low variance alone is not sufficient",
      "detail": "ZZ maps at c >= 0.25: variance falls by 0.27-0.49 decades per qubit; rho(log var, QSVM AUC) = 0.40 [0.18, 0.58]; concentrated kernels (var < 1e-3, mean < 0.1, 17 configs) median AUC 0.550, max 0.720; near-constant kernels (var < 1e-3, mean > 0.5, 5 configs, Z map c=0.05) median AUC 0.782"
    },
    "H4": {
      "held": "yes for ZZ maps",
      "detail": "n=4 Z map, reps 2: c*=0.25, AUC 0.788 vs 0.670 at c=1 (smaller c better); n=4 ZZ map, reps 1: c*=0.05, AUC 0.789 vs 0.493 at c=1 (smaller c better); n=4 ZZ map, reps 2: c*=0.05, AUC 0.785 vs 0.519 at c=1 (smaller c better); n=8 Z map, reps 2: c*=0.25, AUC 0.813 vs 0.707 at c=1 (smaller c better); n=8 ZZ map, reps 1: c*=0.05, AUC 0.804 vs 0.499 at c=1 (smaller c better); n=8 ZZ map, reps 2: c*=0.05, AUC 0.796 vs 0.511 at c=1 (smaller c better)"
    },
    "caveat": "hypotheses phrased after the grid was run: exploratory, not pre-registered"
  },
